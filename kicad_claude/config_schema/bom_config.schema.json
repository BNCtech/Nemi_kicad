{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bom_config.json",
  "type": "object",
  "required": ["property_aliases", "strict_mpn_categories", "text_table", "csv_columns"],
  "properties": {
    "property_aliases":      { "type": "object" },
    "strict_mpn_categories": { "type": "array", "items": { "type": "string" } },
    "text_table": {
      "type": "object",
      "required": ["references_max_width", "footprint_max_width", "ellipsis"],
      "properties": {
        "references_max_width": { "type": "integer", "minimum": 1 },
        "footprint_max_width":  { "type": "integer", "minimum": 1 },
        "ellipsis":             { "type": "string" }
      }
    },
    "csv_columns": { "type": "object" }
  }
}
