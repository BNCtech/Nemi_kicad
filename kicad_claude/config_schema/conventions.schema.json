{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conventions.json",
  "type": "object",
  "required": ["power_symbol", "missing_value_sentinels", "refdes", "grid", "defaults", "wire", "chat", "kicad_string_escapes"],
  "properties": {
    "power_symbol": {
      "type": "object",
      "required": ["lib_id_prefixes", "reference_prefixes"],
      "properties": {
        "lib_id_prefixes":    { "type": "array", "items": { "type": "string" } },
        "reference_prefixes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "missing_value_sentinels": {
      "type": "object",
      "required": ["values"],
      "properties": {
        "values": { "type": "array", "items": { "type": "string" } }
      }
    },
    "refdes": {
      "type": "object",
      "required": ["pattern", "prefixes", "default_priority"],
      "properties": {
        "pattern":          { "type": "string" },
        "prefixes":         { "type": "object" },
        "default_priority": { "type": "integer" }
      }
    },
    "grid": {
      "type": "object",
      "required": ["schematic_mm", "tolerance_mm"],
      "properties": {
        "schematic_mm": { "type": "number", "exclusiveMinimum": 0 },
        "tolerance_mm": { "type": "number", "minimum": 0 }
      }
    },
    "defaults": {
      "type": "object",
      "required": ["footprints"],
      "properties": {
        "footprints": { "type": "object" }
      }
    },
    "wire": {
      "type": "object",
      "required": ["long_threshold_mm"],
      "properties": {
        "long_threshold_mm": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "chat": {
      "type": "object",
      "required": ["history_turns"],
      "properties": {
        "history_turns": { "type": "integer", "minimum": 0 }
      }
    },
    "kicad_string_escapes": { "type": "object" }
  }
}
