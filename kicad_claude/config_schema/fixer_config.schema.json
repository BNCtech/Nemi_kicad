{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fixer_config.json",
  "type": "object",
  "required": ["loop", "gates", "claude", "safety", "layout_guidance"],
  "properties": {
    "loop": {
      "type": "object",
      "required": ["max_iterations", "stop_on_no_progress"],
      "properties": {
        "max_iterations":      { "type": "integer", "minimum": 1 },
        "stop_on_no_progress": { "type": "boolean" }
      }
    },
    "gates": {
      "type": "object",
      "required": ["fix_severities", "success_blocking_severities"],
      "properties": {
        "fix_severities":              { "type": "array", "items": { "type": "string" } },
        "success_blocking_severities": { "type": "array", "items": { "type": "string" } }
      }
    },
    "claude": {
      "type": "object",
      "required": ["max_tokens"],
      "properties": {
        "model":      { "type": ["string", "null"] },
        "max_tokens": { "type": "integer", "minimum": 1 }
      }
    },
    "safety": {
      "type": "object",
      "required": ["allow_delete_component", "max_ops_per_iteration", "backup_before_apply"],
      "properties": {
        "allow_delete_component": { "type": "boolean" },
        "max_ops_per_iteration":  { "type": "integer", "minimum": 1 },
        "backup_before_apply":    { "type": "boolean" }
      }
    },
    "layout_guidance": {
      "type": "object",
      "required": ["decoupling_max_mm", "strap_max_mm", "rail_port_mm", "min_body_gap_mm", "edge_margin_mm"],
      "properties": {
        "decoupling_max_mm": { "type": "number", "exclusiveMinimum": 0 },
        "strap_max_mm":      { "type": "number", "exclusiveMinimum": 0 },
        "rail_port_mm":      { "type": "number", "exclusiveMinimum": 0 },
        "min_body_gap_mm":   { "type": "number", "exclusiveMinimum": 0 },
        "edge_margin_mm":    { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
