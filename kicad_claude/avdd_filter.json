    "series_L_esp":   { "nano": "2u2",  "small": "2u2",  "medium": "2u2",  "large": "2u2",  "xlarge": "2u2"  },
    "vdd_bulk_a":     { "nano": "1u",   "small": "2u2",  "medium": "4u7",  "large": "4u7",  "xlarge": "10u"  },
    "vdd_bulk_b":     { "nano": "1u",   "small": "2u2",  "medium": "4u7",  "large": "4u7",  "xlarge": "10u"  },
    "vdda_bulk_large":{ "nano": "1u",   "small": "4u7",  "medium": "10u",  "large": "10u",  "xlarge": "22u"  },
