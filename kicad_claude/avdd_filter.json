{
  "_comment": "AVDD/VDDA/AVCC isolation network catalog. Synthesized 2026-05-17 from ST AN4488, ATmega328P datasheet §23.5.2 + §28.6.2, Espressif HW Design Guidelines, SAM D21 datasheet, RP2040 datasheet §2.9.6, Nordic nWP030, Microchip support article on AVDD/AVSS. Cap/inductor values are now tier-keyed: circuit_profile.py resolves the correct value at runtime using the active CircuitProfile tier.",

  "_tier_cap_values": {
    "_comment": "Shared lookup table for all families. Keys match 'role' fields below. circuit_profile.py reads profile.avdd_cap(role) which resolves via this table using the active tier. nano/small favour smaller bulk caps (less board space, lower current); large/xlarge favour larger bulk for better transient response.",
    "vdda_bulk":      { "nano": "1u",   "small": "1u",   "medium": "1u",   "large": "4u7",  "xlarge": "10u"  },
    "vdda_decouple":  { "nano": "100n", "small": "100n", "medium": "100n", "large": "100n", "xlarge": "100n" },
    "vref_decouple":  { "nano": "100n", "small": "100n", "medium": "100n", "large": "100n", "xlarge": "100n" },
    "vref_bulk":      { "nano": "1u",   "small": "1u",   "medium": "1u",   "large": "4u7",  "xlarge": "4u7"  },
    "avcc_decouple":  { "nano": "100n", "small": "100n", "medium": "100n", "large": "100n", "xlarge": "100n" },
    "aref_decouple":  { "nano": "100n", "small": "100n", "medium": "100n", "large": "100n", "xlarge": "100n" },
    "vdda_extra_hf":  { "nano": "100n", "small": "100n", "medium": "100n", "large": "100n", "xlarge": "100n" },
